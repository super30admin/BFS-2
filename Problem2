/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    TreeNode x_parent, y_parent;
    int lvl_x, lvl_y;
    public boolean isCousins(TreeNode root, int x, int y) {
        if(root == null){
            return false;
        }
        //doing preorder traversal, store x and y parent nodes and level
        dfs(root, x, y, 0, null);
        //if x and y has different parents and same levels, they are cousins
        return (x_parent != y_parent) && (lvl_x == lvl_y); 
    }

    private void dfs(TreeNode root, int x, int y, int lvl, TreeNode parent){
        if(root == null){
            return ;
        }
        if(root.val == x){
            x_parent = parent;
            lvl_x = lvl;
        }
        if(root.val == y){
            y_parent = parent;
            lvl_y = lvl;
        }
        dfs(root.left, x, y, lvl+1, root);
        dfs(root.right, x, y, lvl+1, root);
    }
}
